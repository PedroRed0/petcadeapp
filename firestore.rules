rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Qualquer pessoa pode ver e cadastrar pets perdidos.
    // (Quando tiver login, troque "if true" por "if request.auth != null".)
    match /pets_perdidos/{petId} {
      allow read: if true;
      allow create: if request.resource.data.nome is string
                    && request.resource.data.nome.size() > 0;
      allow update, delete: if false;
    }
  }
}
